meta {
  name: 1 - Get CSRF token
  type: http
  seq: 1
}

get {
  url: https://localhost:8443/inscription
  body: none
  auth: none
}

script:post-response {
  const html = res.getBody();
  const match = /name="registration\[_token\]"\s+value="([^"]+)"/.exec(html);
  if (match) {
    bru.setVar("csrf_token", match[1]);
  } else {
    console.error("CSRF token introuvable dans le HTML du formulaire");
  }
}

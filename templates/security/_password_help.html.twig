{#
    Aide dynamique a la saisie du mot de passe (pilotee par assets/scripts/app.ts).
    Les regles viennent de RegistrationType : la validation serveur fait autorite.
#}
<div id="password-help"
     class="password-help bg-white border rounded p-3 mt-2 mb-3"
     data-min-length="{{ constant('App\\Form\\RegistrationType::PASSWORD_MIN_LENGTH') }}"
     data-max-length="{{ constant('App\\Form\\RegistrationType::PASSWORD_MAX_LENGTH') }}"
     data-min-score="{{ constant('App\\Form\\RegistrationType::PASSWORD_MIN_SCORE') }}"
     data-password-input="{{ registrationForm.plainPassword.first.vars.id }}"
     data-confirm-input="{{ registrationForm.plainPassword.second.vars.id }}"
     data-identity-inputs="{{ registrationForm.email.vars.id }} {{ registrationForm.nickname.vars.id }}">
    <p class="small mb-1">{{ 'register.password_help.intro'|trans }}</p>

    <div class="progress password-help__meter mb-1" aria-hidden="true">
        <div class="progress-bar" data-password-meter style="width: 0%"></div>
    </div>
    <p class="small mb-2" aria-live="polite">
        {{ 'register.password_help.strength'|trans }} <strong data-password-strength>–</strong>
    </p>

    <ul class="list-unstyled small mb-0" aria-live="polite">
        <li data-password-rule="length">
            {{ 'register.password_help.rule_length'|trans({'%min%': constant('App\\Form\\RegistrationType::PASSWORD_MIN_LENGTH')}) }}
        </li>
        <li data-password-rule="strength">{{ 'register.password_help.rule_strength'|trans }}</li>
        <li data-password-rule="identity">{{ 'register.password_help.rule_identity'|trans }}</li>
        <li data-password-rule="match">{{ 'register.password_help.rule_match'|trans }}</li>
    </ul>

    <p class="small text-body-secondary mt-2 mb-0">{{ 'register.password_help.tip'|trans }}</p>
</div>
